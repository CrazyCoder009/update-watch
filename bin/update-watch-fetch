#!/usr/bin/env python3
"""Fetch Arch/CachyOS news feeds and pending-update count into a local cache.

Run periodically by update-watch.timer. The terminal greeting only reads the
cache this writes, so opening a terminal never touches the network.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.request
import xml.etree.ElementTree as ET
from datetime import datetime, timedelta, timezone
from email.utils import parsedate_to_datetime
from html import unescape

CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "update-watch")
CACHE_FILE = os.path.join(CACHE_DIR, "news.json")
KEEP_DAYS = 45
TIMEOUT = 20

FEEDS = [
    ("Arch", "https://archlinux.org/feeds/news/"),
    ("CachyOS", "https://cachyos.org/rss.xml"),
    ("CachyOS forum", "https://discuss.cachyos.org/c/announcements/5.rss"),
]

# Titles matching these are flagged as likely to need attention before updating.
IMPORTANT = re.compile(
    r"manual intervention|intervention|requires|breaking|broken|break|boot|grub|"
    r"systemd-boot|limine|kernel|nvidia|mesa|mkinitcpio|dracut|deprecat|replace|"
    r"compromis|malicious|incident|regression|rollback|warning|important",
    re.IGNORECASE,
)


def fetch_feed(source, url):
    req = urllib.request.Request(url, headers={"User-Agent": "update-watch/1.0"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        root = ET.fromstring(resp.read())
    items = []
    for it in root.iter("item"):
        title = unescape((it.findtext("title") or "").strip())
        link = (it.findtext("link") or "").strip()
        pub = it.findtext("pubDate")
        if not title or not pub:
            continue
        try:
            date = parsedate_to_datetime(pub.strip())
        except (TypeError, ValueError):
            continue
        if date.tzinfo is None:
            date = date.replace(tzinfo=timezone.utc)
        items.append({
            "source": source,
            "title": title,
            "link": link,
            "date": date.isoformat(),
            "important": bool(IMPORTANT.search(title)),
        })
    return items


def pending_updates():
    """Number of repo packages with updates available, or None if unknown."""
    if not shutil.which("checkupdates"):
        return None
    try:
        out = subprocess.run(["checkupdates"], capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    # exit 0 = updates listed, 2 = none, anything else = error
    if out.returncode == 2:
        return 0
    if out.returncode != 0:
        return None
    return len([l for l in out.stdout.splitlines() if l.strip()])


def main():
    os.makedirs(CACHE_DIR, exist_ok=True)
    try:
        with open(CACHE_FILE) as f:
            cache = json.load(f)
    except (OSError, ValueError):
        cache = {}

    now = datetime.now(timezone.utc)
    cutoff = now - timedelta(days=KEEP_DAYS)
    old_items = {(i["source"], i["link"]): i for i in cache.get("items", [])}
    errors = []
    fresh = {}
    for source, url in FEEDS:
        try:
            for item in fetch_feed(source, url):
                fresh[(item["source"], item["link"])] = item
        except Exception as e:  # network, HTTP, XML: keep old items for this source
            errors.append(f"{source}: {e}")
            for key, item in old_items.items():
                if item["source"] == source:
                    fresh[key] = item

    items = [i for i in fresh.values() if datetime.fromisoformat(i["date"]) >= cutoff]
    items.sort(key=lambda i: i["date"], reverse=True)

    cache["items"] = items
    cache["last_fetch"] = now.isoformat()
    if not errors:
        cache["last_fetch_ok"] = now.isoformat()
    cache["errors"] = errors
    pending = pending_updates()
    if pending is not None:
        cache["pending_updates"] = pending
        cache["pending_checked"] = now.isoformat()

    tmp = CACHE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cache, f, indent=1)
    os.replace(tmp, CACHE_FILE)

    for e in errors:
        print(f"update-watch: fetch failed: {e}", file=sys.stderr)
    print(f"update-watch: {len(items)} news items cached, pending updates: {pending}")


if __name__ == "__main__":
    main()
